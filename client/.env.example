# Public URL consumed by the Next.js client.
# IMPORTANT: NEXT_PUBLIC_* values are embedded into the browser bundle at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1

# Host port mapped to the Next.js container (internal port is 3031).
COLIBRI_CLIENT_PORT=3031


# ==========================================
# CONFIGURACIÓN SMTP PARA ENVÍO DE EMAILS
# Colibrí OS - Nodemailer
# ==========================================

# Servidor SMTP del proveedor de correo.
# Para Gmail, utilizar smtp.gmail.com.
# Si se utiliza otro proveedor, reemplazar por su servidor SMTP.
SMTP_HOST=smtp.gmail.com

# Puerto utilizado para la conexión SMTP.
# 465: conexión SSL/TLS segura desde el inicio.
# 587: conexión con STARTTLS (normalmente SMTP_SECURE=false).
SMTP_PORT=465

# Define si la conexión utiliza TLS desde el inicio.
# true para el puerto 465.
# false para el puerto 587 con STARTTLS.
SMTP_SECURE=true

# Cuenta de correo que Nodemailer utilizará para autenticarse.
# En Gmail, debe ser la dirección completa de la cuenta remitente.
SMTP_USER=tu_correo@gmail.com

# Contraseña de autenticación SMTP.
# Para Gmail, utilizar una contraseña de aplicación generada en Google,
# no la contraseña habitual de la cuenta.
# Nunca compartir este valor ni subirlo al repositorio.
SMTP_PASS=tu_contrasena_de_aplicacion

# Dirección que aparecerá como remitente del email.
# Normalmente debe coincidir con SMTP_USER o ser una dirección
# autorizada por el proveedor SMTP.
MAIL_FROM=tu_correo@gmail.com

# Dirección de correo que recibirá las notificaciones.
# En Colibrí OS, se utiliza para recibir avisos cuando se carga
# correctamente una nueva versión de una microacción.
MAIL_TO=ejemplo@gmail.com

