# QA-001 — variables para la suite Playwright y el entorno aislado.
# NO usar valores de producción. Este archivo es solo para E2E.

# URLs que usa Playwright desde el host
E2E_BACKEND_URL=http://localhost:3000
E2E_FRONTEND_URL=http://localhost:3031

# DB del entorno E2E (puerto host 5433 mapeado al 5432 del contenedor)
E2E_DATABASE_URL=postgresql://colibri_e2e:colibri_e2e@localhost:5433/colibri_e2e

# Secreto JWT del backend E2E (>= 32 chars). Debe coincidir con el backend.
E2E_JWT_SECRET=e2e-jwt-secret-please-change-32-chars-min

# Credenciales sembradas por src/database/seeds/seed-e2e.ts
E2E_PASSWORD=E2e@Passw0rd!
E2E_ADMIN_EMAIL=admin@e2e.colibri
E2E_ENTREPRENEUR_A_EMAIL=entrepreneur-a@e2e.colibri
E2E_ENTREPRENEUR_B_EMAIL=entrepreneur-b@e2e.colibri
E2E_EVALUATOR_EMAIL=evaluator@e2e.colibri
E2E_MENTOR_EMAIL=mentor@e2e.colibri
E2E_GUEST_EMAIL=guest@e2e.colibri
E2E_REVOCATION_EMAIL=revocation@e2e.colibri
E2E_GOOGLE_EXISTING_EMAIL=google-existing@colibri.test

# Opcional: si E2E_BOOTSTRAP=true, global-setup corre migraciones + seed
# usando E2E_BACKEND_DIR (no se usa con docker compose, que ya lo hace).
E2E_BOOTSTRAP=false
E2E_BACKEND_DIR=../../colibri_os_back

# Re-siembra el dataset antes de cada corrida para que la suite sea
# re-ejecutable. Usa `docker compose exec` si E2E_COMPOSE_FILE está definido.
E2E_RESEED=true
E2E_COMPOSE_FILE=docker-compose.e2e.yml
