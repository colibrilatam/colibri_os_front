{
  "name": "colibri-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "QA-001: suite Playwright E2E (sesión, permisos, CSRF, OAuth) sobre un entorno aislado.",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --reporter=list,junit,html",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "env:up": "docker compose --env-file .env.e2e -f docker-compose.e2e.yml up -d --wait --build",
    "env:down": "docker compose --env-file .env.e2e -f docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
